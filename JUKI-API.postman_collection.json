				{
					"name": "Verification Actions",
					"item": [
						{
							"name": "Verify Payment (ACCEPT)",
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"action\": \"ACCEPT\"\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/admin/payments/:userId/verify",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"admin",
										"payments",
										":userId",
										"verify"
									],
									"variable": [
										{
											"key": "userId",
											"value": "{{user_id}}"
										}
									]
								}
							},
							"response": []
						},
						{
							"name": "Verify Payment (REJECT)",
							"request": {
								"method": "POST",
								"header": [],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"action\": \"REJECT\",\n    \"reason\": \"Bukti transfer tidak jelas.\"\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/admin/payments/:userId/verify",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"admin",
